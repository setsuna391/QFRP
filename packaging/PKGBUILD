# Arch / CachyOS 打包脚本(生成 pacman 包)
# 使用前把本文件复制到项目根目录,并把 source 改为项目目录的打包形式,例如:
#   source=("qml-frpc-$pkgver.tar.gz")  ← 先在项目根目录执行: git archive -o qml-frpc-0.1.0.tar.gz HEAD
# 或直接改用 packaging/install-local.sh 装到 ~/.local(无需 makepkg)。
#
# 依赖系统 Qt6,不捆绑 Qt 库;frpc 已内置在应用资源里,无需额外依赖。

pkgname=qml-frpc
pkgver=0.1.0
pkgrel=1
pkgdesc="QFRP — SakuraFrp 隧道管理客户端 (Qt6)"
arch=('x86_64' 'aarch64')
url="https://www.natfrp.com/"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'gcc-libs' 'glibc')
makedepends=('cmake')
source=("qml-frpc-$pkgver.tar.gz")
md5sums=('SKIP')
options=(!strip)  # 保留调试符号;正式发布可去掉

build() {
  tar -xf "qml-frpc-$pkgver.tar.gz"
  cd "qml-frpc-$pkgver"
  cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib
  cmake --build build -j"$(nproc)"
}

package() {
  cd "qml-frpc-$pkgver"
  DESTDIR="${pkgdir}" cmake --install build
}
